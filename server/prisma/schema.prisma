datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id                 String   @id @default(uuid())
  title              String
  description        String
  category           String   // 'Frontend' | 'Backend' | 'Full Stack' | 'AI'
  techStack          String   // Comma separated values
  features           String   // New-line separated values
  githubUrl          String
  liveUrl            String
  liveUrlAdmin       String?
  image              String
  problemStatement   String
  architecture       String
  challenges         String
  learnings          String
  databaseDesign     String
  apiEndpoints       String
  futureImprovements String
}

model Skill {
  id       String @id @default(uuid())
  name     String
  category String // 'Frontend' | 'Backend' | 'Databases' | 'Programming' | 'Tools' | 'AI'
  level    Int    // 0-100
  icon     String
}

model Experience {
  id          String @id @default(uuid())
  role        String
  company     String
  duration    String
  description String // New-line separated values
  type        String // 'Internship' | 'Freelance' | 'Leadership' | 'Volunteer'
  order       Int    @default(0)
}

model Achievement {
  id          String  @id @default(uuid())
  title       String
  description String
  date        String
  type        String  // 'Contest' | 'Hackathon' | 'Certification' | 'Award' | 'OpenSource'
  link        String?
  order       Int     @default(0)
}

model Certificate {
  id       String @id @default(uuid())
  title    String
  issuer   String
  date     String
  image    String
  pdfUrl   String
  category String
  order    Int    @default(0)
}

model Blog {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  content     String
  tags        String   // Comma separated values
  category    String
  date        String
  published   Boolean  @default(true)
}

model Message {
  id      String   @id @default(uuid())
  name    String
  email   String
  subject String
  message String
  status  String   @default("unread") // 'unread' | 'read'
  date    DateTime @default(now())
}

model Analytics {
  id        String   @id @default(uuid())
  path      String   @unique
  views     Int      @default(0)
  clicks    Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Visitor {
  id    String @id @default("singleton")
  count Int    @default(0)
}
